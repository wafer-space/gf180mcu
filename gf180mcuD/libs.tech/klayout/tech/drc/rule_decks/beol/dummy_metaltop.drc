if TABLES.include?('dummy_metaltop') || BEOL
  #================================================
  #--------------- Dummy MetalTop -----------------
  #================================================

  # Rule DMT.2b: Min Dummy metal line space (for DRC): 0.98
  logger.info('Executing rule DMT.2b')
  dmt_2b_l1 = top_metal_dummy.space(0.98.um, euclidian)
  dmt_2b_l1.output('DMT.2b', 'DMT.2b : Min Dummy metal line space (for DRC): 0.98')
  dmt_2b_l1.forget

  # Rule DMT.3: Minimum space between dummy metal and circuit Metal line: 2
  logger.info('Executing rule DMT.3')
  dmt_3_l1 = top_metal_dummy.separation(top_metal, 2.um, euclidian)
  dmt_3_l1.output('DMT.3', 'DMT.3 : Minimum space between dummy metal and circuit Metal line: 2')
  dmt_3_l1.forget

  # Rule DMT.8: Minimum space between dummy metal and FuseTop, POLYFUSE, FUSEWINDOW_D, PMNDMY, MTPMK, OTP_MK: 6
  logger.info('Executing rule DMT.8')
  dmt_8_l1 = top_metal_dummy.separation(fusetop, 6.um, euclidian)
  dmt_8_l1 += top_metal_dummy.separation(polyfuse, 6.um, euclidian)
  dmt_8_l1 += top_metal_dummy.separation(fusewindow_d, 6.um, euclidian)
  dmt_8_l1 += top_metal_dummy.separation(pmndmy, 6.um, euclidian)
  dmt_8_l1 += top_metal_dummy.separation(mtpmark, 6.um, euclidian)
  dmt_8_l1 += top_metal_dummy.separation(otp_mk, 6.um, euclidian)
  dmt_8_l1.output('DMT.8', 'DMT.8 : Minimum space between dummy metal and FuseTop, POLYFUSE, FUSEWINDOW_D, PMNDMY, MTPMK, OTP_MK: 6')
  dmt_8_l1.forget

end
